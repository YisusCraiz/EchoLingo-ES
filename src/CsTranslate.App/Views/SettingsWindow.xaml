<Window x:Class="CsTranslate.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EchoLingo ES" Width="560" Height="740" MinWidth="400" MinHeight="460"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#101827" Foreground="#F1F5F9" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#AAB9CE" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,5,0,10" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A2638" />
            <Setter Property="BorderBrush" Value="#304056" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101B2B" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="CaretBrush" Value="#5EEAD4" />
            <Setter Property="BorderBrush" Value="#52647C" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,5,0,14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#5EEAD4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Native popup uses a light surface so selected text and dropdown items stay readable. -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#EDF2F7" />
            <Setter Property="Foreground" Value="#142033" />
            <Setter Property="BorderBrush" Value="#69829D" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#142033" />
            <Setter Property="Background" Value="#EDF2F7" />
            <Setter Property="Padding" Value="10,8" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#BAE6FD" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="#E5EDF8" />
            <Setter Property="Background" Value="#2C405B" />
            <Setter Property="BorderBrush" Value="#52647C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#AAB9CE" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabFrame" Background="Transparent" CornerRadius="8,8,0,0"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabFrame" Property="Background" Value="#1A2638" />
                                <Setter TargetName="TabFrame" Property="BorderBrush" Value="#5EEAD4" />
                                <Setter Property="Foreground" Value="#5EEAD4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabFrame" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="EchoLingo" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="{DynamicResource Ui_0}" Style="{StaticResource Muted}" Margin="0,3,8,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0">
                <TextBlock Text="{DynamicResource Ui_40}" FontSize="11" Margin="0,0,0,4" />
                <ComboBox x:Name="InterfaceLanguagePicker" Width="125" SelectedValuePath="Tag"
                          SelectionChanged="OnInterfaceLanguageChanged" AutomationProperties.Name="Español / English">
                    <ComboBoxItem Content="Español" Tag="es" />
                    <ComboBoxItem Content="English" Tag="en" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Background="#101827" BorderThickness="0" Padding="0,12,0,0">
            <TabItem Header="{DynamicResource Ui_1}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Ui_2}" Style="{StaticResource Heading}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button x:Name="DetectAudioButton" Grid.Column="1" Content="{DynamicResource Ui_3}" Click="OnDetectAudioClicked" ToolTip="{DynamicResource Ui_4}" />
                                </Grid>
                                <TextBlock Text="{DynamicResource Ui_5}" Style="{StaticResource Muted}" />
                                <ComboBox x:Name="ActiveAudioProcessesComboBox" DisplayMemberPath="Label"
                                          MaxDropDownHeight="200" SelectionChanged="OnAudioProcessSelected"
                                          AutomationProperties.Name="{DynamicResource Ui_6}" />
                                <Border Background="#101B2B" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Ui_7}" FontSize="10" FontWeight="Bold" Foreground="#AAB9CE" Margin="0,0,0,7" />
                                        <ProgressBar x:Name="AudioLevelMeter" Minimum="0" Maximum="100" Value="0" Height="10"
                                                     Foreground="#5EEAD4" Background="#304056" BorderThickness="0"
                                                     AutomationProperties.Name="{DynamicResource Ui_8}" />
                                        <TextBlock x:Name="AudioLevelText" Text="{DynamicResource Ui_9}"
                                                   Style="{StaticResource Muted}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Ui_10}" Style="{StaticResource Heading}" />
                                <TextBlock Text="{DynamicResource Ui_11}" Style="{StaticResource Muted}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Ui_12}" Foreground="#AAB9CE" Margin="0,0,0,6" />
                                        <ComboBox x:Name="SpokenLanguagePicker" SelectedValuePath="Tag" SelectionChanged="OnSpokenLanguageChanged"
                                                  AutomationProperties.Name="{DynamicResource Ui_13}">
                                            <ComboBoxItem Content="{DynamicResource Ui_14}" Tag="" />
                                            <ComboBoxItem Content="{DynamicResource Ui_15}" Tag="en" />
                                            <ComboBoxItem Content="{DynamicResource Ui_16}" Tag="es" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Ui_17}" Foreground="#AAB9CE" Margin="0,0,0,6" />
                                        <ComboBox x:Name="TargetLanguagePicker" SelectedValuePath="Tag" SelectionChanged="OnTargetLanguageChanged"
                                                  AutomationProperties.Name="{DynamicResource Ui_18}">
                                            <ComboBoxItem Content="{DynamicResource Ui_16}" Tag="es" />
                                            <ComboBoxItem Content="{DynamicResource Ui_15}" Tag="en" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Ui_19}" Style="{StaticResource Heading}" />
                                <TextBlock Text="{DynamicResource Ui_20}"
                                           Style="{StaticResource Muted}" />
                                <Button Content="{DynamicResource Ui_21}" Click="OnPreviewOverlayClicked" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource Ui_22}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Ui_23}" Style="{StaticResource Heading}" />
                                <TextBlock Text="{DynamicResource Ui_24}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{DynamicResource Ui_25}" />
                                <TextBox x:Name="ProcessNameBox" ToolTip="{DynamicResource Ui_26}" />
                                <TextBlock Text="{DynamicResource Ui_27}" />
                                <TextBox x:Name="WhisperModelPathBox" />
                                <Button Content="{DynamicResource Ui_28}" Click="OnBrowseModelClicked" HorizontalAlignment="Left" Margin="0,0,0,16" />
                                <TextBlock Text="{DynamicResource Ui_29}" />
                                <TextBox x:Name="LibreTranslateUrlBox" />
                                <Expander Header="{DynamicResource Ui_30}" Foreground="#AAB9CE">
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="{DynamicResource Ui_31}" />
                                        <TextBox x:Name="TargetLanguageBox" />
                                        <TextBlock Text="{DynamicResource Ui_32}" />
                                        <TextBox x:Name="WhisperLanguageBox" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Border Background="#101B2B" BorderBrush="#304056" BorderThickness="1"
                    CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="72">
                    <TextBlock x:Name="StatusText" Text="{DynamicResource Ui_33}"
                               Foreground="#CBD5E1" FontSize="12" />
                </ScrollViewer>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Content="{DynamicResource Ui_34}" Background="#5EEAD4" Foreground="#102B2B"
                        BorderBrush="#5EEAD4" Click="OnStartClicked" Margin="0,0,8,0" />
                <Button x:Name="StopButton" Grid.Column="1" Content="{DynamicResource Ui_35}" Click="OnStopClicked" IsEnabled="False" Margin="0,0,8,0" />
                <Button x:Name="CloseButton" Grid.Column="2" Content="{DynamicResource Ui_36}" Click="OnCloseClicked" Background="#101827" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>

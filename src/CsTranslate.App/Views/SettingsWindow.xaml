<Window x:Class="CsTranslate.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EchoLingo ES"
        Width="540"
        Height="700"
        MinWidth="440"
        MinHeight="540"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF181818"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4C9AFF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF6BAAFF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFE05A5A" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF232323" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FF3A3A3A" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF9A9A9A" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="EchoLingo ES"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold" />
                <TextBlock Text="Sigue estos pasos para activar los subtítulos traducidos."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           Margin="0,2,0,16" />

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="1. Elige la aplicación con audio"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Reproduce una voz o sonido y pulsa Buscar audio."
                                   Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap" />
                        <Button x:Name="DetectAudioButton"
                                Content="Buscar audio ahora"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Padding="14,8"
                                Margin="0,2,0,8"
                                Click="OnDetectAudioClicked" />
                        <TextBlock Text="Después selecciona la aplicación detectada."
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,2" />
                        <ComboBox x:Name="ActiveAudioProcessesComboBox"
                                  DisplayMemberPath="Label"
                                  MaxDropDownHeight="180"
                                  SelectionChanged="OnAudioProcessSelected"
                                  Background="{StaticResource SurfaceBrush}"
                                  Foreground="White"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  Padding="9,8"
                                  Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="2. Elige el idioma de los subtítulos"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Escribe el código del idioma destino. Español: es · inglés: en."
                                   Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="TargetLanguageBox"
                                 Text="es"
                                 Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="3. Configura dónde aparecen los subtítulos"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Cuando aparezca una traducción, pulsa F9 para activar el modo de edición. Arrastra el recuadro para moverlo o usa la esquina inferior derecha para cambiar su tamaño. Pulsa F9 otra vez al terminar."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Expander Header="Opciones avanzadas"
                          Foreground="White"
                          Margin="0,0,0,12">
                    <StackPanel Margin="4,10,4,0">
                        <TextBlock Text="Nombre del proceso (alternativa manual)"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ProcessNameBox" />

                        <TextBlock Text="Modelo Whisper (.bin)"
                                   Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WhisperModelPathBox"
                                     Grid.Column="0"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="Buscar archivo"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,8"
                                    Click="OnBrowseModelClicked" />
                        </Grid>

                        <TextBlock Text="Idioma hablado (vacío = detectar automáticamente)"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="WhisperLanguageBox" />

                        <TextBlock Text="Servidor local de traducción"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="LibreTranslateUrlBox"
                                 Margin="0,0,0,4" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <TextBlock x:Name="StatusText"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           Text="Listo. Reproduce audio y busca la aplicación." />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton"
                        Grid.Column="0"
                        Content="Iniciar subtítulos"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,6,0"
                        Click="OnStartClicked" />
                <Button x:Name="StopButton"
                        Grid.Column="1"
                        Content="Detener"
                        Style="{StaticResource SecondaryButton}"
                        Margin="6,0,6,0"
                        IsEnabled="False"
                        Click="OnStopClicked" />
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Content="Cerrar"
                        Style="{StaticResource DangerButton}"
                        Margin="6,0,0,0"
                        Click="OnCloseClicked" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>

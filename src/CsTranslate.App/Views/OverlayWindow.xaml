<Window x:Class="CsTranslate.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EchoLingo ES - Subtítulos"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Manual"
        Width="480"
        Height="180"
        MinWidth="320"
        MinHeight="90"
        MaxWidth="1200"
        MaxHeight="700"
        WindowStartupLocation="Manual"
        Left="100"
        Top="700">
    <Border x:Name="DragSurface"
            Background="#CC101010"
            CornerRadius="6"
            Padding="10"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="OnMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="EditModeHint"
                       Grid.Row="0"
                       Text="Modo edición: arrastra para mover y usa la esquina inferior derecha para cambiar el tamaño. F9 para terminar."
                       Foreground="#FFD966"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"
                       Visibility="Collapsed" />
            <TextBlock x:Name="OverlayPlaceholder" Grid.Row="1"
                       Text="Aquí aparecerán los subtítulos. Inicia la captura y reproduce una voz. F9 permite mover y cambiar el tamaño."
                       Foreground="#CCCCCC" FontSize="14" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding OriginalText}"
                                           Foreground="#AAAAAA"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding TranslatedText}"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
